{
  "name": "nocturne-script-mystery",
  "version": "0.1.0",
  "private": true,
  "description": "A premium script-mystery social game MVP with automatic script ingestion.",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --check public/app.js",
    "db:migrate": "node scripts/migrate-neon.mjs",
    "assets:generate": "node scripts/generate-icon.mjs",
    "mobile:sync": "npm run check && npx cap sync",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
